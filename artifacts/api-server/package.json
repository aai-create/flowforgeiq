{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kill -9 $(lsof -ti tcp:${PORT}) 2>/dev/null; fuser -k ${PORT}/tcp 2>/dev/null; sleep 0.5; export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/express": "^2.1.23",
    "@clerk/shared": "^4.15.0",
    "@e965/xlsx": "^0.20.3",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bplist-creator": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postmark": "^4.0.7",
    "qrcode": "^1.5.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^3.2.6"
  }
}
