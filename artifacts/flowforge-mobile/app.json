{
  "expo": {
    "name": "FlowForge",
    "slug": "flowforge-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flowforge-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8800ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flowforge.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FlowForge needs access to your photo library to attach images to shipment messages.",
        "NSCameraUsageDescription": "FlowForge needs camera access to capture documents for shipment messages.",
        "NSPhotoLibraryAddUsageDescription": "FlowForge needs access to save photos.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.flowforge.mobile",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#8800ff",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlowForge needs access to your photos to attach images to messages.",
          "cameraPermission": "FlowForge needs camera access to capture documents."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": ["text/*", "image/*", "application/pdf"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
